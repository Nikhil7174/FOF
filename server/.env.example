# Pooled URL — used by the API at runtime (Neon: host contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct URL — required for prisma migrate deploy / migrate dev (Neon: host WITHOUT -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Local Postgres: you can set DIRECT_URL to the same value as DATABASE_URL

JWT_SECRET="change-me"
PORT=3000
NODE_ENV="development"
